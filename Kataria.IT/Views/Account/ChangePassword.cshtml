@model ChangePasswordVm
@{ ViewData["Title"] = "Password change"; }
<div class="row justify-content-center"><div class="col-md-6 col-lg-5"><div class="card"><div class="card-body">
<h1 class="h5 mb-3">Password change karein</h1>
<form asp-action="ChangePassword" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
    <label class="form-label">Current password</label><input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" /><span asp-validation-for="CurrentPassword" class="text-danger small"></span>
    <label class="form-label mt-3">New Password</label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="NewPassword" class="text-danger small"></span>
    <label class="form-label mt-3">New Password</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    <button class="btn btn-primary mt-4">Save</button>
</form></div></div></div></div>
