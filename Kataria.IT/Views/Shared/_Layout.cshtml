<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "IT Monitoring") · Kataria IT</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <nav class="navbar navbar-expand-lg navbar-dark app-nav no-print">
        <div class="container-xl">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index"><i class="bi bi-hdd-network me-2"></i>KATARIA <small class="fw-normal opacity-75">IT Operations</small></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Create"><i class="bi bi-plus-circle"></i> New Report</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Index"><i class="bi bi-calendar3"></i> Report History</a></li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index"><i class="bi bi-people"></i> Users</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Drive" asp-action="Index"><i class="bi bi-google"></i> Google Drive</a></li>
                    }
                </ul>
                <div class="dropdown">
                    <a class="nav-link dropdown-toggle text-white" href="#" data-bs-toggle="dropdown"><i class="bi bi-person-circle"></i> @(User.FindFirst("DisplayName")?.Value ?? User.Identity!.Name)</a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">Password change</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post"><button class="dropdown-item">Sign out</button></form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>
}
<main class="container-xl py-4">
    @if (TempData["Success"] is string ok) { <div class="alert alert-success alert-dismissible fade show no-print">@ok<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
    @if (TempData["Error"] is string err) { <div class="alert alert-danger alert-dismissible fade show no-print">@err<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
    @RenderBody()
</main>
<footer class="text-center small text-secondary pb-4 no-print">Kataria Distribution Center · Internal IT reporting system</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
