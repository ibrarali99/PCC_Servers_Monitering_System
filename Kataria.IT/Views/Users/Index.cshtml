@model UsersVm
@{ ViewData["Title"] = "Users"; }
<div class="mb-3"><div class="eyebrow">ADMIN</div><h1 class="h3 fw-bold">Users</h1></div>

<div class="panel">
    <h2>New user</h2>
    <form asp-action="Create" method="post" class="row g-3">
        <div asp-validation-summary="All" class="text-danger small"></div>
        <div class="col-md-3"><label class="form-label">Username</label><input name="NewUser.Username" value="@Model.NewUser.Username" class="form-control" required /></div>
        <div class="col-md-3"><label class="form-label">Display name</label><input name="NewUser.DisplayName" value="@Model.NewUser.DisplayName" class="form-control" required /></div>
        <div class="col-md-3"><label class="form-label">Password (min 6)</label><input name="NewUser.Password" type="password" class="form-control" required minlength="6" autocomplete="new-password" /></div>
        <div class="col-md-2"><label class="form-label">Role</label><select name="NewUser.Role" class="form-select"><option>Staff</option><option>Admin</option></select></div>
        <div class="col-md-1 d-flex align-items-end"><button class="btn btn-primary w-100">Add</button></div>
    </form>
</div>

<div class="card"><div class="table-responsive"><table class="table align-middle mb-0">
    <thead><tr><th>Username</th><th>Name</th><th>Role</th><th>Status</th><th>Last login</th><th class="text-end">Actions</th></tr></thead>
    <tbody>
    @foreach (var u in Model.Users)
    {
        <tr>
            <td class="fw-semibold">@u.Username</td><td>@u.DisplayName</td><td>@u.Role</td>
            <td>@if (u.IsActive) { <span class="badge text-bg-success">Active</span> } else { <span class="badge text-bg-secondary">Disabled</span> }</td>
            <td>@(u.LastLoginUtc?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "—")</td>
            <td class="text-end">
                <form asp-action="ResetPassword" asp-route-id="@u.UserId" method="post" class="d-inline-flex gap-1">
                    <input name="newPassword" type="password" class="form-control form-control-sm" placeholder="New password" style="width:150px" minlength="6" autocomplete="new-password" />
                    <button class="btn btn-sm btn-outline-primary">Reset</button>
                </form>
                <form asp-action="Toggle" asp-route-id="@u.UserId" method="post" class="d-inline"><button class="btn btn-sm btn-outline-secondary">@(u.IsActive ? "Disable" : "Enable")</button></form>
            </td>
        </tr>
    }
    </tbody></table></div></div>
