<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering>
          <!-- allow up to 250 MB per report upload (photos) -->
          <requestLimits maxAllowedContentLength="262144000" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
